{
  "name": "jkas-ui",
  "version": "0.0.0",
  "scripts": {
    "start:en": "ng serve --configuration=en",
    "start:ms": "ng serve --configuration=ms",
    "build:en": "node --max_old_space_size=5048 ./node_modules/@angular/cli/bin/ng build --configuration=production --output-path=dist --base-href=/en/ --build-optimizer --vendor-chunk --common-chunk",
    "build:ms": "node --max_old_space_size=5048 ./node_modules/@angular/cli/bin/ng build --configuration=production --output-path=dist --base-href=/ms/ --build-optimizer --vendor-chunk --common-chunk",
    "build-locale:ms": "ng build --configuration production --build-optimizer --vendor-chunk --common-chunk --i18n-locale ms --i18n-format xlf --i18n-file src/i18n/messages.ms.xlf --output-path=dist/ms --baseHref /ms/",
    "build-locale:en": "ng build --configuration production --build-optimizer --vendor-chunk --common-chunk --i18n-locale en --i18n-format xlf --i18n-file src/i18n/messages.en.xlf  --output-path=dist/en --baseHref /en/",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "npm run build -- --configuration production --aot",
    "build-serve": "node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng build --optimization=false --configuration=ms --base-href=/ms/",
    "i18n:extract": "ng xi18n --output-path src/i18n",
    "build-locale": "npm run build-locale:ms && npm run build-locale:en",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~12.2.13",
    "@angular/cdk": "^12.2.12",
    "@angular/cli": "^12.2.13",
    "@angular/common": "~12.2.13",
    "@angular/compiler": "~12.2.13",
    "@angular/core": "~12.2.13",
    "@angular/forms": "~12.2.13",
    "@angular/localize": "^12.2.13",
    "@angular/material": "^12.2.13",
    "@angular/platform-browser": "~12.2.13",
    "@angular/platform-browser-dynamic": "~12.2.13",
    "@angular/router": "~12.2.13",
    "@arcgis/core": "^4.21.2",
    "@asymmetrik/ngx-leaflet": "^8.1.0",
    "@ngx-translate/core": "^13.0.0",
    "@ngx-translate/http-loader": "^6.0.0",
    "@types/arcgis-js-api": "^4.19.0",
    "@types/leaflet": "^1.7.0",
    "angular-highcharts": "^11.3.1",
    "angular-ng-autocomplete": "^2.0.12",
    "bootstrap": "^4.6.0",
    "chart.js": "^2.9.3",
    "chartjs-plugin-datalabels": "^1.0.0",
    "esri-leaflet": "^3.0.2",
    "esri-leaflet-geocoder": "^3.1.3",
    "esri-loader": "^3.1.0",
    "faker": "^5.5.3",
    "file-saver": "^2.0.5",
    "highcharts": "^9.0.1",
    "jquery": "^3.6.0",
    "jspdf": "^2.4.0",
    "jspdf-autotable": "^3.5.23",
    "leaflet": "^1.7.1",
    "ng-multiselect-dropdown": "^0.3.8",
    "ng-sidebar": "^9.4.2",
    "ng2-charts": "^2.4.2",
    "ng2-file-upload": "^1.4.0",
    "ng2-smart-table": "^1.7.2",
    "ng2-sticky-nav": "^9.0.1",
    "ngx-bootstrap": "^6.2.0",
    "ngx-countdown": "^11.0.3",
    "ngx-owl-carousel-o": "^5.0.0",
    "ngx-pagination": "^5.0.0",
    "ngx-print": "^1.2.1",
    "ngx-spinner": "^10.0.1",
    "primeicons": "^7.0.0",
    "primeng": "^12.2.1",
    "rxjs": "~6.6.7",
    "rxjs-compat": "^6.6.7",
    "swiper": "^11.2.4",
    "tslib": "^2.0.0",
    "xlsx": "^0.17.3",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.2.13",
    "@angular/compiler-cli": "~12.2.13",
    "@angular/language-service": "~12.2.13",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/jspdf": "^2.0.0",
    "@types/node": "~8.9.4",
    "codelyzer": "^6.0.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.7",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~2.0.1",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "ng2-completer": "^9.0.1",
    "protractor": "~7.0.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "~4.3.5"
  }
}
