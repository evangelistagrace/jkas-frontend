{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "b3650a89-72d1-42c7-87b9-c8da590cc5b7"
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "JKAS-UI": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "aot": false,
            "assets": [
              {
                "glob": "**/*",
                "input": "./node_modules/leaflet/dist/images",
                "output": "leaflet/"
              },
              {
                "glob": "**/*",
                "input": "./node_modules/esri-leaflet-geocoder/dist/img",
                "output": "esri-leaflet-geocoder/"
              },
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/custom-theme.scss",
              "./node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "./node_modules/leaflet/dist/leaflet.css",
              "./node_modules/esri-leaflet-geocoder/dist/esri-leaflet-geocoder.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
              "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/primeng/resources/themes/saga-blue/theme.css",
              "node_modules/primeng/resources/primeng.min.css",
              "node_modules/swiper/swiper-bundle.css",
              "src/styles.css"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/jspdf-autotable/dist/jspdf.plugin.autotable.js",
              "src/assets/js/jquery.easing.min.js"
            ],
            "vendorChunk": true,
            "extractLicenses": false,
            "buildOptimizer": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true
          },
          "configurations": {
            "production": {
              "localize": ["en", "ms"],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "36mb"
                }
              ]
            },
            "ms": {
              "outputPath": "dist",
              "aot": true,
              "i18nMissingTranslation": "error",
              "localize": ["ms"]
            },
            "en": {
              "outputPath": "dist",
              "aot": true,
              "i18nMissingTranslation": "error",
              "localize": ["en"]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "JKAS-UI:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "JKAS-UI:build:production"
            },
            "ms": {
              "browserTarget": "JKAS-UI:build:ms"
            },
            "en": {
              "browserTarget": "JKAS-UI:build:en"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "JKAS-UI:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "src/styles.css",
              "./node_modules/leaflet/dist/leaflet.css"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "tsconfig.app.json",
              "tsconfig.spec.json",
              "e2e/tsconfig.json"
            ],
            "exclude": ["**/node_modules/**"]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "JKAS-UI:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "JKAS-UI:serve:production"
            }
          }
        }
      },
      "i18n": {
        "locales": {
          "ms": {
            "translation": "src/i18n/messages.ms.xlf",
            "baseHref": ""
          },
          "en": {
            "translation": "src/i18n/messages.en.xlf",
            "baseHref": ""
          }
        }
      }
    }
  },
  "defaultProject": "JKAS-UI"
}
